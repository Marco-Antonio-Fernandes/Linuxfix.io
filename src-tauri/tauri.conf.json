{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fixio Shell", "version": "0.1.0", "identifier": "io.fixio.shell",
  "build": { "beforeDevCommand": "npm run web:dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build:web", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "Fixio Shell · Personalização", "width": 1260, "height": 880, "minWidth": 760, "minHeight": 600, "visible": false }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com" }
  },
  "bundle": { "active": true, "targets": ["appimage"], "category": "Utility", "shortDescription": "Seu desktop, do seu jeito", "icon": ["icons/icon.png"] }
}
